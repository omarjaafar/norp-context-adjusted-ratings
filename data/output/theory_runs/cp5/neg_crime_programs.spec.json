{
  "spec_version": 1,
  "theory_id": "neg_crime_programs",
  "theory": "In counties with more violent crime, nonprofits spend a smaller share of their budget on programs.",
  "source": "scout mapping (CP4 Planner)",
  "written_by": "Planner agent (claude-sonnet-5-5)",
  "outcome": "program_expense_ratio",
