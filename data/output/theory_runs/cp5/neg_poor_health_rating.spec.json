{
  "spec_version": 1,
  "theory_id": "neg_poor_health_rating",
  "theory": "Nonprofits in counties where more adults report poor or fair health get lower scores on the standard 0-10 financial score.",
  "source": "scout mapping (poor/fair health exposure)",
  "written_by": "Planner agent (claude-sonnet-5-5)",
  "outcome": "standard_rating",
  "exposure": "chr_poor_fair_health",
  "exposure_type": "continuous",
  "expected_sign": -1,
  "exposure_unit": "county_fips",
  "exposure_varies_by": "tax_year",
  "population": {
    "return_type": [
      "990"
    ],
    "require_true": [
      "has_county"
    ],
    "require_present": [
      "standard_rating",
      "chr_poor_fair_health",
      "log_revenue",
      "category",
      "county_fips",
      "state",
      "tax_year"
    ]
  },
  "hypotheses": [
    {
      "id": "H1",
      "claim": "The standard rating is negatively correlated with the county share of adults reporting poor or fair health.",
      "method": "correlation"
    },
    {
      "id": "H2",
      "claim": "The negative association remains after controlling for organization size, sector, state, tax year, and county socioeconomic and health-access context.",
      "method": "fixed_effects",
      "controls": [
        "log_revenue",
        "poverty_rate",
        "median_household_income",
        "chr_uninsured",
        "chr_some_college",
        "nonprofit_density"
      ],
      "absorb": [
        "tax_year",
        "category",
        "state"
      ],
      "cluster": "county_fips"
    }
  ],
  "robustness": [
    {
      "id": "H2_multilevel_2022",
      "method": "multilevel",
      "controls": [
        "log_revenue",
        "poverty_rate",
        "median_household_income",
        "chr_uninsured",
        "chr_some_college",
        "nonprofit_density"
      ],
      "categorical": [
        "category",
        "state"
      ],
      "group": "county_fips",
      "years": [
        2022
      ]
    },
    {
      "id": "H2_county_year_means",
      "method": "two_stage_group_means",
      "controls": [
        "log_revenue",
        "poverty_rate",
        "median_household_income",
        "chr_uninsured",
        "chr_some_college",
        "nonprofit_density"
      ],
      "absorb": [
        "tax_year",
        "category",
        "state"
      ],
      "groups": [
        "county_fips",
        "tax_year"
      ]
    }
  ],
  "validator": {
    "alpha": 0.05,
    "effect_floor_sd": 0.1,
    "n_permutations": 999,
    "seed": 6235,
    "permutation": {
      "keep_paths": true,
      "studentized": true
    },
    "holdout": {
      "by": "state",
      "folds": 5
    },
    "holdout_year": 2022,
    "outcome_rule": {
      "heavy_tail_ratio": 3.0,
      "winsorize": [
        0.01,
        0.99
      ]
    }
  },
  "gate_overrides": []
}