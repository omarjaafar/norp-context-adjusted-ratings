{
  "spec_version": 1,
  "theory_id": "pos_uninsured_admin",
  "theory": "In counties with more uninsured people, nonprofits spend a larger share of their budget on management and administration.",
  "source": "scout mapping",
  "written_by": "Planner agent (claude-sonnet-5-5)",
  "outcome": "admin_expense_ratio",
  "exposure": "chr_uninsured",
  "exposure_type": "continuous",
  "expected_sign": 1,
  "exposure_unit": "county_fips",
  "exposure_varies_by": "tax_year",
  "population": {
    "return_type": [
      "990"
    ],
    "require_true": [
      "has_county"
    ],
    "require_present": [
      "admin_expense_ratio",
      "chr_uninsured",
      "log_revenue",
      "category",
      "county_fips",
      "state",
      "tax_year",
      "median_household_income",
      "poverty_rate"
    ]
  },
  "hypotheses": [
    {
      "id": "H1",
      "claim": "The administrative expense ratio is positively correlated with the county uninsured share.",
      "method": "correlation"
    },
    {
      "id": "H2",
      "claim": "The positive association remains after controlling for organization size (log revenue), county median household income and poverty rate, and absorbing sector (category), state and tax year.",
      "method": "fixed_effects",
      "controls": [
        "log_revenue",
        "median_household_income",
        "poverty_rate"
      ],
      "absorb": [
        "tax_year",
        "category",
        "state"
      ],
      "cluster": "county_fips"
    }
  ],
  "robustness": [
    {
      "id": "H2_multilevel_2022",
      "method": "multilevel",
      "controls": [
        "log_revenue",
        "median_household_income",
        "poverty_rate"
      ],
      "categorical": [
        "category",
        "state"
      ],
      "group": "county_fips",
      "years": [
        2022
      ]
    },
    {
      "id": "H2_county_year_means",
      "method": "two_stage_group_means",
      "controls": [
        "log_revenue",
        "median_household_income",
        "poverty_rate"
      ],
      "absorb": [
        "tax_year",
        "category",
        "state"
      ],
      "groups": [
