{
  "spec_version": 1,
  "theory_id": "distressed_county_rating_penalty",
  "theory": "Organizations in the most economically distressed quarter of counties receive lower scores on the context-blind 0-10 standard financial rating.",
  "source": "docs/ratings_theory.md",
  "written_by": "Planner agent (claude-sonnet-5-5)",
  "outcome": "standard_rating",
  "exposure": "high_need",
  "expected_sign": -1,
  "exposure_unit": "county_fips",
  "exposure_varies_by": "tax_year",
  "population": {
    "return_type": [
      "990"
    ],
    "require_true": [
      "has_county",
      "has_need"
    ],
    "require_present": [
      "standard_rating",
      "high_need",
      "log_revenue",
      "category",
      "county_fips"
    ]
  },
  "hypotheses": [
    {
      "id": "H1",
      "claim": "The mean standard rating is lower in high-need counties than elsewhere.",
      "method": "difference_in_means"
    },
    {
      "id": "H2",
      "claim": "The gap remains after controlling for organization size (log revenue), sector (NORP category), state and tax year.",
      "method": "fixed_effects",
      "controls": [
        "log_revenue"
      ],
      "absorb": [
        "tax_year",
        "category",
        "state"
      ],
      "cluster": "county_fips"
    }
  ],
  "robustness": [
    {
      "id": "H2_multilevel_2022",
      "method": "multilevel",
      "controls": [
        "log_revenue"
      ],
      "categorical": [
        "category",
        "state"
      ],
      "group": "county_fips",
      "years": [
        2022
      ]
    },
    {
      "id": "H2_county_year_means",
      "method": "two_stage_group_means",
      "controls": [
        "log_revenue"
      ],
      "absorb": [
        "tax_year",
        "category",
        "state"
      ],
      "groups": [
        "county_fips",
        "tax_year"
      ]
    }
  ],
  "validator": {
    "alpha": 0.05,
    "effect_floor_sd": 0.1,
    "n_permutations": 999,
    "seed": 6235,
    "permutation": {
      "keep_paths": true,
      "studentized": true
    },
    "holdout": {
      "by": "state",
      "folds": 5
    },
    "holdout_year": 2022
  },
  "gate_overrides": []
}